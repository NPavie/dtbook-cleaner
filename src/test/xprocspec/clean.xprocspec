<?xml version="1.0" encoding="UTF-8" ?>
<x:description
    xmlns:x="http://www.daisy.org/ns/xprocspec"
    xmlns:pxi="http://www.daisy.org/ns/pipeline/xproc/internal"
    xmlns:px="http://www.daisy.org/ns/pipeline/xproc"
    script="../../main/resources/xml/clean.xpl"
>

    <x:scenario label="Clean execution test">
        <x:call step="px:dtbook-clean">
            <x:input port="source">
                <x:document type="inline">
                    <dtbook
                        xmlns="http://www.daisy.org/z3986/2005/dtbook/"
                        version="2005-3"
                    >
                        <head>
                            <meta
                                name="dc:Identifier"
                                content="9780120348123"
                                scheme="ean13"
                            />
                        </head>
                        <book>
                            <frontmatter>
                                <doctitle>Test repair</doctitle>
                                <docauthor>DAISY Consortium</docauthor>
                            </frontmatter>
                            <bodymatter>
                                <level1>
                                    <h1>Test 1</h1>
                                    <p>First chapter<noteref
                                            id="noteref-1"
                                        /></p>
                                    <h1>Test 2</h1>
                                    <p>Second chapter<annoref
                                            id="annoref-1"
                                        /></p>
                                </level1>
                                <level1>
                                    <level2>
                                        <h1>Test 3</h1>
                                        <p>Third chapter</p>
                                    </level2>
                                </level1>
                                <level1>
                                    <h1>Test 4</h1>
                                    <p>Fourth chapter</p>
                                    <h2>Subchapter</h2>
                                    <p>First subchapter</p>
                                    <p>
                                        <p>Nested paragraph</p>
                                    </p>
                                </level1>
                                <level1>
                                    <h1>Empty chapter</h1>
                                </level1>
                            </bodymatter>
                        </book>
                    </dtbook>
                </x:document>
            </x:input>
            <x:option name="tidy" select="true()" />
            <x:option name="repair" select="true()" />
            <x:option name="narrator" select="false()" />
            <x:option name="ApplySentenceDetection" select="true()" />
            <x:option name="documentLanguage" select="'fr-FR'" />
            <x:option name="publisher" select="'DAISY Consortium'" />
        </x:call>
        <x:context label="the processed dtbook 2005-3">
            <x:document type="port" port="result.fileset" />
        </x:context>
        <x:expect
            label="the dtbook 2005-3 should be as expected"
            type="compare"
        >
            <x:document type="inline">
                <dtbook
                    xmlns="http://www.daisy.org/z3986/2005/dtbook/"
                    version="2005-3"
                >
                    <head>
                        <meta name="dtb:uid" content="9780120348123" />
                        <meta name="dc:Title" content="Test repair" />
                        <meta
                            name="dc:Identifier"
                            content="9780120348123"
                            scheme="ean13"
                        />
                    </head>
                    <book>
                        <frontmatter>
                            <doctitle>Test repair</doctitle>
                            <docauthor>DAISY Consortium</docauthor>
                        </frontmatter>
                        <bodymatter>
                            <level1>
                                <h1>Test 1</h1>
                                <p>First chapter<noteref
                                        id="noteref-1"
                                        idref="#"
                                    /></p>
                                    &lt;/level1&gt;&lt;level1&gt;<h1>Test 2</h1>
                                <p>Second chapter<annoref
                                        id="annoref-1"
                                        idref="#"
                                    /></p>
                            </level1>
                            <level1>
                                <h1>Test 3</h1>
                                <p>Third chapter</p>
                            </level1>
                            <level1>
                                <h1>Test 4</h1>
                                <p>Fourth chapter</p>
                                <level2>
                                    <h2>Subchapter</h2>
                                    <p>First subchapter</p>
                                    <p>Nested paragraph</p>
                                </level2>
                            </level1>
                            <level1>
                                <h1>Empty chapter</h1>
                                <p />
                            </level1>
                        </bodymatter>
                    </book>
                </dtbook>
            </x:document>
        </x:expect>
    </x:scenario>

</x:description>
